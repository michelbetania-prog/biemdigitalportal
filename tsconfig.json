{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "createElement",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "outDir": ".compiled",
    "rootDir": "src",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "src/main.jsx",
    "src/App.jsx",
    "src/icons.jsx",
    "src/mini-react.js",
    "src/data/account-data.js",
    "src/AdminApp.jsx",
    "src/data/admin-data.js"
  ]
}
